# Base URL of your Podium instance (origin only, no path).
PODIUM_URL=http://192.168.1.10:3456
# Podium's PODIUM_AUTH_TOKEN, if you set one. Stays server-side; never sent to the browser.
PODIUM_TOKEN=
# Optional: Dispatcharr, for per-stream FPS / codec / audio on the Channels page.
# Set both or neither. The key stays server-side.
DISPATCHARR_URL=
DISPATCHARR_API_KEY=
# Port the production server listens on (the container uses 8080).
PORT=8080
# Extra Host names Rostrum answers to, beyond private IPs and .lan/.local names,
# e.g. the name a reverse proxy serves it on: ROSTRUM_ALLOWED_HOSTS=rostrum.example.com
# (comma or space separated; ".example.com" or "*.example.com" match subdomains;
# a pasted URL works too, its scheme, port and path are ignored).
ROSTRUM_ALLOWED_HOSTS=
# Where Rostrum keeps what it records (Trends, soaks, Connect events, channel history;
# a SQLite file). The container sets /data/rostrum.db on a volume. Unset, history is
# off; uncomment to record it in dev (data/ is git-ignored).
# HISTORY_DB=data/rostrum.db
